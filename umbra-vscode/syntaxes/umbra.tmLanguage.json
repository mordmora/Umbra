{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Umbra",
  "scopeName": "source.umbra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#function-calls" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.umbra",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.umbra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.umbra",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.umbra",
              "match": "\\{\\}"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.umbra",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.umbra",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.umbra",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.umbra",
          "match": "\\b(if|else|elseif|repeat|times|return)\\b"
        },
        {
          "name": "keyword.other.function.umbra",
          "match": "\\b(func)\\b"
        },
        {
          "name": "keyword.operator.logical.umbra",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.umbra",
          "match": "\\b(equal|different|less_than|greater_than|less_or_equal|greater_or_equal)\\b"
        },
        {
          "name": "keyword.other.memory.umbra",
          "match": "\\b(new|delete|ptr|ref|access)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.umbra",
          "match": "\\b(int|float|bool|char|string|array|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.umbra",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.umbra",
          "match": "->"
        },
        {
          "name": "keyword.operator.increment.umbra",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitshift.umbra",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.umbra",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.umbra",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.umbra",
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.function.umbra" },
            "2": { "name": "entity.name.function.umbra" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.builtin.umbra",
          "match": "\\b(print|read|input)\\b(?=\\s*\\()"
        },
        {
          "name": "meta.function-call.umbra",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.umbra" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.umbra",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
